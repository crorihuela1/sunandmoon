# Postiz environment overrides — Sun & Moon at 30a
# Copy to postiz.env and fill in. Used alongside the official compose repo:
#   git clone https://github.com/gitroomhq/postiz-docker-compose
# Full reference: https://docs.postiz.com/configuration/reference

# --- URLs (set all three to your public domain) ---
MAIN_URL="https://social.sunandmoonat30a.com"
FRONTEND_URL="https://social.sunandmoonat30a.com"
NEXT_PUBLIC_BACKEND_URL="https://social.sunandmoonat30a.com/api"

# --- Security ---
# Generate with: openssl rand -base64 32
JWT_SECRET="CHANGE_ME"
# After you create your account, disable public registration:
DISALLOW_REGISTRATION=true

# --- Instagram + Facebook (same Meta app serves both) ---
# From developers.facebook.com > your app > App settings > Basic
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""

# --- Optional: media storage on Cloudflare R2 (recommended — you're already on CF) ---
# STORAGE_PROVIDER="cloudflare"
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_ACCESS_KEY=""
# CLOUDFLARE_SECRET_ACCESS_KEY=""
# CLOUDFLARE_BUCKETNAME=""
# CLOUDFLARE_BUCKET_URL=""
# CLOUDFLARE_REGION="auto"

# --- Other providers, add as you go ---
# X_API_KEY="" / X_API_SECRET=""          (X/Twitter)
# LINKEDIN_CLIENT_ID="" / LINKEDIN_CLIENT_SECRET=""
# YOUTUBE_CLIENT_ID="" / YOUTUBE_CLIENT_SECRET=""
# TIKTOK_CLIENT_ID="" / TIKTOK_CLIENT_SECRET=""
# Per-provider guides: https://docs.postiz.com/providers/overview
