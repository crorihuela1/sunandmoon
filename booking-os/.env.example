# Sun & Moon Booking OS — environment variables
# =====================================================================
# Cloudflare Worker: set these with `npx wrangler secret put <NAME>`
#   (secrets) or in [vars] in wrangler.toml (non-secret config).
# Local dev: copy the SECRETS block into booking-os/.dev.vars
#   (gitignored) for `npx wrangler dev`.
# Notifier (booking-os/notify_agent.py): reads Twilio + Gmail from
#   referral-os/.env.
#
# EMPTY = graceful degrade. SMS silently falls back to iMessage/email
# until Twilio is set; Mindy gets nothing until VACAY_CONTACT_* are set;
# checkout stays in "request to book" mode until Stripe keys are set.
# =====================================================================

# ── SECRETS (wrangler secret put) ────────────────────────────────────
SUPABASE_URL=https://iwxzishzszducqwxfmbd.supabase.co
SUPABASE_SERVICE_KEY=            # service-role JWT (referral-os/.env → SUPABASE_SERVICE_ROLE_KEY)
ADMIN_TOKEN=                     # hidden admin path /admin/<token>  (openssl rand -hex 12)
WEBHOOK_SECRET=                  # shared secret for Vacay webhook header x-webhook-secret
WEBHOOK_HMAC_SECRET=             # optional: Vacay HMAC signing secret (x-vacay-signature)

# Stripe (checkout increment — site stays request-to-book until these are set)
STRIPE_SECRET_KEY=               # sk_test_… then sk_live_…
STRIPE_WEBHOOK_SECRET=           # whsec_… (payment success/failure/dispute)
STRIPE_PUBLISHABLE_KEY=          # pk_test_… (client)

# Twilio (SMS — silently falls back until all three are set)
TWILIO_ACCOUNT_SID=              # AC…
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=              # +1… (pending Twilio compliance review)

# ── CONFIG (wrangler.toml [vars]) ────────────────────────────────────
PROJECT_ID=310c4ae6-eec9-47b7-9e22-b95a6dc69365
NOTIFY_OWNER_EMAIL=corihuela@gmail.com
NOTIFY_OWNER_SMS=3057753405
ADMIN_ALERT_PHONE=3057753405     # sync-drift + failed-charge alerts

# Phase-1 two-way availability — Mindy at Vacay.
# BLANK = she receives nothing (testing). Fill BOTH to notify her on
# confirmed bookings so Vacay can block the dates on their side.
VACAY_CONTACT_EMAIL=             # mindy@vacayrentalnetwork.com
VACAY_CONTACT_PHONE=             # Mindy's mobile
