# Postgres / Supabase
DATABASE_URL=postgresql://postgres:password@db.xyz.supabase.co:5432/postgres
SUPABASE_URL=https://xyz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ZoomInfo — MCP mode (used inside Cowork)
ZI_VIA_MCP=0

# ZoomInfo — HTTP mode (standalone scripts/cron)
ZOOMINFO_USERNAME=
ZOOMINFO_CLIENT_ID=
ZOOMINFO_PRIVATE_KEY=

# Apollo (waterfall layer 2)
APOLLO_API_KEY=

# Hunter (waterfall layer 3, email verification)
HUNTER_API_KEY=

# Postmark / Resend (transactional + open-click tracking)
POSTMARK_SERVER_TOKEN=
# or
RESEND_API_KEY=

# Tracking Worker secrets (set via `wrangler secret put`, not here)
# SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# IP_SALT
# FALLBACK_REDIRECT

# Airtable (only if running scripts/sync_airtable.py)
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
