# Copy to .env (never commit). In CI these live as GitHub Actions secrets.
# Each block becomes relevant when its platform reaches `keys_received`.

# master switch — nothing posts or emails for real until this is "true"
SOCIAL_LIVE=false

# calendars (only needed for google_calendar sources; iCal URLs need nothing)
GOOGLE_CALENDAR_API_KEY=

# notifier (SMTP — Google Workspace, Zoho, Postmark, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Meta (Instagram + Facebook + Threads share one app)
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
FB_PAGE_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# X / Twitter
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Pinterest
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=

# Buffer (aggregator fast path)
BUFFER_ACCESS_TOKEN=

# TikTok (adapter pending)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# YouTube (adapter pending)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# Google Business Profile (adapter pending)
GBP_CLIENT_ID=
GBP_CLIENT_SECRET=
GBP_REFRESH_TOKEN=
GBP_LOCATION_ID=

# LinkedIn (adapter pending)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# Nextdoor (adapter pending)
NEXTDOOR_ACCESS_TOKEN=
